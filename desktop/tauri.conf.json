{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bens Super Cool Image Stabilizer",
  "version": "0.1.0",
  "identifier": "com.benstev.minis",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Removes camera shake with the smallest possible crop.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "ffmpeg/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "ffmpeg/ffprobe.exe": "ffmpeg/ffprobe.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
